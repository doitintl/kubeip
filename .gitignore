**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Keep .terraform.lock.hcl files tracked for reproducible providers.

# Sonar Scanner
.scannerwork/

# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# IDE support files
.idea/
.vscode/

# Operating system metadata
.DS_Store
Thumbs.db

