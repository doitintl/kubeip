# Go build, test, coverage, and profiling artifacts
/.bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
*.pprof
*.cover
*.coverprofile
.run/

# Local Go workspaces for this single-module repository
go.work
go.work.sum

# Local environment and credentials
.env
.env.*
!.env.example
.in
.out
.credentials

